# Telegram bot token (get from @BotFather)
BOT_TOKEN=your-bot-token-from-botfather

# LMS backend API URL
LMS_API_URL=http://localhost:42002

# LMS backend API key (same as LMS_API_KEY in .env.docker.secret)
LMS_API_KEY=your-lms-api-key

# LLM API credentials (from Qwen Code API setup)
LLM_API_KEY=your-llm-api-key
LLM_API_BASE_URL=http://localhost:42005/v1
LLM_API_MODEL=coder-model
